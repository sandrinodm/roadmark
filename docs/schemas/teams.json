{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "patternProperties": {
    "^[a-z0-9]+(?:-[a-z0-9]+)*$(?!\\s)": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S",
          "description": "Nonblank text."
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "\\S",
              "description": "Nonblank text."
            },
            "description": {
              "type": "string",
              "pattern": "\\S",
              "description": "Nonblank text."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {}
}
