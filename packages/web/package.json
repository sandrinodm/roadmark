{
  "name": "@roadmark/web",
  "version": "0.0.0",
  "private": true,
  "description": "Renders a compiled roadmap into static HTML pages, styles and the browser enhancement bundle.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "e2e": "e2e run",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client/tsconfig.browser.json && tsc --noEmit -p src/client/tsconfig.test.json && tsc --noEmit -p e2e"
  },
  "dependencies": {
    "@roadmark/compiler": "workspace:*",
    "@ui-sdk/core": "0.1.0-beta.16",
    "@ui-sdk/web": "0.1.0-beta.16",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@e2e-dev/core": "0.24.0",
    "@e2e-dev/web": "0.16.1",
    "@happy-dom/global-registrator": "21.0.4",
    "@roadmark/test-fixtures": "workspace:*",
    "axe-core": "4.14.1",
    "e2e": "0.24.0",
    "happy-dom": "21.0.4",
    "parse5": "^8.1.1"
  }
}
