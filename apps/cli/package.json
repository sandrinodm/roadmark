{
  "name": "roadmark",
  "version": "0.1.0",
  "description": "Compile a team's Markdown roadmap into a searchable static site.",
  "keywords": [
    "cli",
    "markdown",
    "mdx",
    "product-management",
    "roadmap",
    "static-site"
  ],
  "homepage": "https://github.com/sandrinodm/roadmark#readme",
  "bugs": {
    "url": "https://github.com/sandrinodm/roadmark/issues"
  },
  "license": "MIT",
  "author": "Sandrino Di Mattia (https://github.com/sandrinodm)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandrinodm/roadmark.git",
    "directory": "apps/cli"
  },
  "bin": {
    "roadmark": "./lib/main.js"
  },
  "files": [
    "lib",
    "templates/blank",
    "templates/ai-sandbox",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "benchmark": "node scripts/benchmark.ts",
    "build": "node scripts/package.ts",
    "prepack": "pnpm build",
    "test": "node --test 'src/**/*.test.ts' 'scripts/**/*.test.ts'",
    "test:package": "node scripts/installed-cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "chokidar": "^6.0.0",
    "effect": "4.1.4",
    "esbuild": "^0.28.2",
    "mermaid": "13.0.0-alpha.2",
    "parse5": "^8.1.1",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@roadmark/compiler": "workspace:*",
    "@roadmark/test-fixtures": "workspace:*",
    "@roadmark/web": "workspace:*",
    "@types/proper-lockfile": "^4.1.4"
  },
  "engines": {
    "node": ">=26"
  }
}
